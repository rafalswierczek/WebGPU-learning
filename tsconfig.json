{
    "compilerOptions": {
        "rootDir": "./src/ts/",
        "outDir": "./public/build/",
        "target": "ES2020",
        "module": "ESNext",
        // webpack rozwiązuje importy, więc TS musi szukać modułów tak jak bundler (domyślne "Classic" nie zagląda do node_modules)
        "moduleResolution": "bundler",
        "lib": ["ES2020", "DOM", "DOM.Iterable"], // This is to prevent lib.dom.d.ts from being used as a type documentation. @webgpu/types is used instead. DOM.Iterable adds document.fonts.add() (FontFaceSet extends Set there).
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "@webgpu/types"
        ]
    },
    "include": [
        "src/ts/**/*",
        "types.d.ts",
        "wgsl.d.ts"
    ],
    "exclude": [
        "node_modules"
    ],
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Recommended"
}
